{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnusedImports": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"style": {
				"useTemplate": {
					"level": "info",
					"fix": "safe"
				}
			},
			"complexity": {
				"useLiteralKeys": {
					"level": "info",
					"fix": "safe"
				}
			}
		},
		"domains": {
			"react": "recommended"
		}
	}
}
