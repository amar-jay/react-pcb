{
	"name": "react-pcb",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"board:inspect": "bun run preview inspect",
		"board:build": "bun run preview build",
		"board:dev": "bun run preview dev",
		"test": "bun test",
		"rust:fmt": "cargo fmt --all -- --check",
		"rust:check": "cargo check --workspace --all-targets",
		"rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
		"rust:test": "cargo test --workspace",
		"check": "bunx tsc --noEmit && bun run rust:fmt && bun run rust:check && bun run rust:lint && bun run rust:test && bun test",
		"prettify": "bunx biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@react-pcb/preview": "workspace:*",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.2.2",
		"bun-plugin-tailwind": "^0.1.2",
		"react": "^19.3.0",
		"typescript": "^7.0.2"
	}
}
