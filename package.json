{
  "name": "react-pcb-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "example": "bun run examples/basic.tsx",
    "example:esc": "bun run examples/esc/index.tsx",
    "footprints:inspect": "bun run examples/footprints/inspect.ts",
    "footprints:esc:inspect": "bun run examples/esc/footprints/inspect.tsx",
    "board:build": "bun run react-pcb-preview build",
    "board:dev": "bun run react-pcb-preview dev",
    "preview:build": "bun run packages/preview/src/frontend/build.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "check": "bun run rust:fmt && bun run typecheck && bun run rust:check && bun run rust:lint && bun run rust:test && bun test",
    "rust:fmt": "cargo fmt --all -- --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@react-pcb/preview": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.2",
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
