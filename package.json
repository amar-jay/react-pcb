{
  "name": "react-pcb-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "example": "bun run examples/basic.tsx",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "check": "bun run typecheck && bun test && bun run rust:check && bun run rust:lint && bun run rust:test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.2",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
